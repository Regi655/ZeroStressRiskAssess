# ZeroStressRiskAssess - the repository contains ONLY what is needed to use and evaluate the tool.
#
# Allow-list approach: everything in the root is ignored (/*) and only the entries below are re-included (!).
# Any new file created while testing (reports, notes, keys, Grype output...) therefore stays out of the
# repository by default. A new top-level file is published only after adding it explicitly to this list.
/*

# --- re-included
!/.gitignore
!/README.md
# installation: required for "git clone + README" to work
!/pyproject.toml
!/requirements.txt
!/setup.sh
# the tool
!/zerostressriskassess/
# CVE verification utilities
!/tools/
# Docker lab: needed to test the whole system
!/lab/
# sample report and screenshots (from the lab, fake data)
!/docs/

# --- always excluded, including inside re-included directories
__pycache__/
*.pyc
# lab SSH key (generated by lab/lab.sh)
lab/.ssh/
# secrets
.env
*.pem
*.key
# archive of removed code (local only, see removed-code.md)
removed-code.md
# Grype output or test reports saved inside re-included directories
grype-*.json
reports/
report.json
report.md
report.html
*.sha256

# Excluded by the first rule and therefore never published: .venv/, vendor/ (Lynis, fetched by setup.sh),
# reports/ (they describe the weaknesses of the assessed machines), tests/, .github/, requirements-dev.txt.

hosts.txt

# Hosts for the inventory mode